// Copy to secrets.h (gitignored, never commit real credentials) and fill in
// real values for your deployment.
#pragma once

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// DNS hostname is required for TLS certificate validation. No plaintext fallback.
#define MQTT_HOST "cattletracker.tech"
#define MQTT_PORT 8883
#define MQTT_USERNAME "gateway"
#define MQTT_PASSWORD "replace-with-mosquitto-passwd-value"
#define MQTT_TOPIC "cattle-tracker/telemetry"

// Unique per physical gateway/receiver, sent with every published message so
// the backend can tell which receiver forwarded a packet.
#define GATEWAY_ID "GATEWAY-0001"
